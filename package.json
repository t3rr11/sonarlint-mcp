{
  "name": "sonarlint-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing local SonarQube for IDE (SonarLint) static analysis: scan files, folders, or whole projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sonarlint-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "setup": "node scripts/fetch-analyzers.mjs",
    "postinstall": "node scripts/fetch-analyzers.mjs",
    "build": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "t3rr11 (https://github.com/t3rr11)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t3rr11/sonarlint-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/t3rr11/sonarlint-mcp/issues"
  },
  "homepage": "https://github.com/t3rr11/sonarlint-mcp#readme",
  "keywords": [
    "mcp",
    "sonarlint",
    "sonarqube",
    "static-analysis",
    "linter",
    "code-quality"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
